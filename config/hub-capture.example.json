{
  "id": "capture",
  "namespace": "capture",
  "transport": "reverse-websocket",
  "product_id": "flamoris.capture",
  "connector_token_env": "CAPTURE_CONNECTOR_TOKEN",
  "tools": [
    {
      "name": "mcp.context",
      "description": "Current live identity, revision and permission.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "capture.session.get",
      "description": "Read the currently approved window and limits. No sessionId needed; no pixels or window enumeration.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runtimeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "documentToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expectedRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 19
              }
            },
            "required": [
              "runtimeId",
              "documentToken"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "input"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "capture.screenshot.get",
      "description": "Capture the currently shared window. No sessionId needed; no target switching. PNG/JPEG <= 1 MiB.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "maxEdge": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1920,
                "default": 1280
              },
              "format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpeg"
                ],
                "default": "jpeg"
              },
              "requireExactSize": {
                "type": "boolean",
                "default": false
              },
              "roi": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runtimeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "documentToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expectedRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 19
              }
            },
            "required": [
              "runtimeId",
              "documentToken"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "input"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "capture.recording.get",
      "description": "Read the current recording summary and bounded resource counters. Acquisition is controlled by the human UI.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runtimeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "documentToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expectedRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 19
              }
            },
            "required": [
              "runtimeId",
              "documentToken"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "input"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "capture.events.get",
      "description": "Read a page of recorded target-window key and mouse events, relative to the recording QPC time origin. Never starts recording.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "afterSequence": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500,
                "default": 100
              }
            },
            "additionalProperties": false
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runtimeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "documentToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expectedRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 19
              }
            },
            "required": [
              "runtimeId",
              "documentToken"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "input"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "capture.frame.get",
      "description": "Read one recorded frame by zero-based frameIndex OR recording-relative timeMs. Omit both for latest. Returns one bounded image; never uploads video.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "frameIndex": {
                "type": "integer",
                "minimum": 0
              },
              "timeMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runtimeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "documentToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expectedRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 19
              }
            },
            "required": [
              "runtimeId",
              "documentToken"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "input"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "capture.contactSheet.get",
      "description": "Read 1-9 evenly spaced recorded frames as ONE image with cell bounds and exact frame indices/timestamps. No video transfer.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9,
                "default": 6
              }
            },
            "additionalProperties": false
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runtimeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "documentToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expectedRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 19
              }
            },
            "required": [
              "runtimeId",
              "documentToken"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "input"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
}
